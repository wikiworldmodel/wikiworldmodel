{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "viewer",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 5173
    },
    {
      "name": "viewer-timelapse",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["vite", "--config", "viewer/vite.config.ts", "--port", "5183", "--strictPort"],
      "port": 5183
    },
    {
      "name": "site",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "5190", "--bind", "127.0.0.1", "--directory", "site"],
      "port": 5190
    }
  ]
}
