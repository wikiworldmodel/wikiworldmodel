# Headers for Cloudflare Pages (https://developers.cloudflare.com/pages/configuration/headers/).
# The site's layout is in tools/world/src/site.ts. The builds are in R2, served with their own
# headers (tools/world/publish-build.sh); the index naming the latest build is here, and changes.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/world/builds/index.json
  Cache-Control: no-cache
  Access-Control-Allow-Origin: *

/ATTRIBUTION.md
  Content-Type: text/plain; charset=utf-8
