{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wikiworldmodel.invalid/schema/generator.json",
  "title": "Generator",
  "description": "Versioned code plus parameters plus a seed, run by the build and the client, whose outputs agree within the tolerance of core/fingerprint.ts.",
  "type": "object",
  "required": ["id", "type", "title", "version", "code", "runs_in", "outputs", "inputs", "slots", "params"],
  "properties": {
    "id": { "type": "string", "$ref": "defs.json#/$defs/record_id", "pattern": "^gen:" },
    "type": { "const": "generator" },
    "title": { "type": "string" },
    "version": { "type": "integer", "minimum": 1 },
    "code": { "type": "string" },
    "runs_in": { "type": "array", "items": { "enum": ["build", "client"] } },
    "outputs": {
      "type": "object",
      "required": ["basis"],
      "properties": { "basis": { "const": "procedural" } },
      "additionalProperties": false
    },
    "inputs": { "type": "array", "description": "What it reads from the world as constraints. Empty only where it takes nothing from the world", "items": { "$ref": "defs.json#/$defs/input" } },
    "slots": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "defs.json#/$defs/key" },
      "additionalProperties": {
        "type": "object",
        "required": ["place", "seed"],
        "properties": { "place": { "type": "string" }, "seed": { "type": "string", "minLength": 1 } },
        "additionalProperties": false
      }
    },
    "params": { "type": "object" }
  },
  "additionalProperties": false
}
