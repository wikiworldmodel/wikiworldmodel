{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lightworld.invalid/schema/field.json",
  "title": "Field",
  "description": "A continuous quantity over space and time: a grid on a frame, or a series with one value for the whole planet at each time. Its arrays live outside git. A derived field is declared, never stored.",
  "type": "object",
  "required": ["id", "type", "title"],
  "properties": {
    "id": { "type": "string", "$ref": "defs.json#/$defs/record_id", "pattern": "^field:" },
    "type": { "const": "field" },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "quantity": { "type": "string" },
    "unit": { "type": "string" },
    "datum": { "type": "string" },
    "frame": { "$ref": "defs.json#/$defs/ref" },
    "grid": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "res_deg"],
          "properties": { "kind": { "const": "lonlat" }, "res_deg": { "type": "number", "exclusiveMinimum": 0 } },
          "additionalProperties": false
        },
        {
          "description": "A series: one value for the whole planet at each time",
          "type": "object",
          "required": ["kind"],
          "properties": { "kind": { "const": "series" } },
          "additionalProperties": false
        }
      ]
    },
    "time": {
      "type": "object",
      "required": ["lo", "hi"],
      "properties": { "lo": { "$ref": "defs.json#/$defs/time_point" }, "hi": { "$ref": "defs.json#/$defs/time_point" }, "step": { "$ref": "defs.json#/$defs/duration" } },
      "additionalProperties": false
    },
    "data": {
      "type": "object",
      "required": ["from"],
      "properties": {
        "from": { "$ref": "defs.json#/$defs/ref" },
        "file": { "type": "string", "description": "The dataset's file, where it has several" },
        "sheet": { "type": "string", "description": "For a workbook: the sheet the series is on" },
        "first_row": { "type": "integer", "minimum": 1, "description": "For a workbook: the first row of data" },
        "columns": {
          "description": "For a series read from a table: the columns of its time, its value and the band around it; names in a text table, letters in a workbook",
          "type": "object",
          "required": ["time", "value"],
          "properties": { "time": { "type": "string" }, "value": { "type": "string" }, "lo": { "type": "string" }, "hi": { "type": "string" } },
          "additionalProperties": false
        },
        "time_unit": { "enum": ["Ma", "ka", "BP", "CE"], "description": "What the time column counts: Ma, ka or years before 1950, or calendar years" },
        "band": { "type": "string", "description": "What the lo–hi band is, e.g. the 5th–95th percentiles of an ensemble" }
      },
      "additionalProperties": false
    },
    "basis": { "$ref": "defs.json#/$defs/basis" },
    "interp": { "enum": ["step", "linear", "log-time", "plate-warp"] },
    "moves_with": { "$ref": "defs.json#/$defs/ref" },
    "projection": {
      "description": "After its youngest snapshot, the field holds that snapshot as a projection until `until`",
      "type": "object",
      "required": ["method", "until"],
      "properties": { "method": { "const": "hold" }, "until": { "$ref": "defs.json#/$defs/time_point" }, "note": { "type": "string" } },
      "additionalProperties": false
    },
    "derived": { "const": true },
    "from": { "type": "array", "minItems": 1, "items": { "$ref": "defs.json#/$defs/ref" } },
    "rule": { "enum": ["isoline", "gough-1981"] },
    "isoline_m": { "type": "number" },
    "params": { "type": "object", "description": "The rule's parameters" },
    "source": { "$ref": "defs.json#/$defs/citation", "description": "Where the rule comes from" }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "required": ["derived"] },
      "then": { "required": ["rule"], "not": { "anyOf": [{ "required": ["data"] }, { "required": ["basis"] }] } },
      "else": { "required": ["data", "basis", "grid", "time"] }
    },
    { "if": { "required": ["rule"], "properties": { "rule": { "const": "isoline" } } }, "then": { "required": ["from"] } },
    { "if": { "required": ["rule"], "properties": { "rule": { "const": "gough-1981" } } }, "then": { "required": ["grid", "time", "params", "source"] } },
    { "if": { "required": ["grid"], "properties": { "grid": { "type": "object", "properties": { "kind": { "const": "lonlat" } } } } }, "then": { "required": ["frame"] } }
  ]
}
