{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lightworld.invalid/schema/defs.json",
  "title": "Shared definitions",
  "$defs": {
    "entity_id": {
      "description": "An entity id: lowercase words joined by /. It carries no meaning and never changes.",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]*(/[a-z0-9][a-z0-9.-]*)+$"
    },
    "record_id": {
      "description": "A prefixed record id, e.g. src:renne-2013 or frame:paleomap/plate-201",
      "type": "string",
      "pattern": "^(src|frame|field|gen|tour|alt):[a-z0-9][a-z0-9.-]*(/[a-z0-9][a-z0-9.-]*)*$"
    },
    "ref": {
      "description": "A reference: an entity id (with @phase or #key), local @phase or #key, a prefixed record id, or scheme:id",
      "type": "string",
      "pattern": "^([@#][a-z0-9][a-z0-9-]*|[a-z0-9][a-z0-9.-]*(/[a-z0-9][a-z0-9.-]*)+([@#][a-z0-9][a-z0-9-]*)?|[a-z][a-z0-9-]*:\\S+)$"
    },
    "key": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "time_point": {
      "description": "A decimal astronomical year; a number with CE, BCE, BP, ka, Ma, Ga, or kyr/Myr/Gyr from now; or a calendar date or month, such as 15 March 44 BCE (Julian before 15 October 1582, Gregorian after, unless it names its calendar)",
      "oneOf": [
        { "type": "number" },
        { "type": "string", "pattern": "^-?\\d+(\\.\\d+)?(e[+-]?\\d+)? (CE|BCE|BP|ka|Ma|Ga|kyr from now|Myr from now|Gyr from now)$" },
        { "type": "string", "pattern": "^(\\d{1,2} )?(January|February|March|April|May|June|July|August|September|October|November|December) \\d+ (CE|BCE)( Julian| Gregorian)?$" }
      ]
    },
    "duration": {
      "description": "Years, or a number with days, yr, kyr, Myr or Gyr",
      "oneOf": [
        { "type": "number", "minimum": 0 },
        { "type": "string", "pattern": "^\\d+(\\.\\d+)?(e[+-]?\\d+)? (days?|yr|kyr|Myr|Gyr)$" }
      ]
    },
    "lag": {
      "oneOf": [
        { "$ref": "#/$defs/duration" },
        {
          "type": "object",
          "minProperties": 1,
          "properties": { "lo": { "$ref": "#/$defs/duration" }, "hi": { "$ref": "#/$defs/duration" } },
          "additionalProperties": false
        }
      ]
    },
    "time": {
      "description": "A point, an interval {lo, hi} (lo is the earlier; an end may be open or unknown), a normal distribution {mean, sd}, unknown, or another record's interval or edge {ref, edge, lag}",
      "oneOf": [
        { "$ref": "#/$defs/time_point" },
        { "const": "unknown" },
        {
          "type": "object",
          "minProperties": 1,
          "properties": {
            "lo": { "oneOf": [{ "$ref": "#/$defs/time_point" }, { "const": "unknown" }] },
            "hi": { "oneOf": [{ "$ref": "#/$defs/time_point" }, { "const": "unknown" }] }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["mean", "sd"],
          "properties": { "mean": { "$ref": "#/$defs/time_point" }, "sd": { "$ref": "#/$defs/duration" } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["ref"],
          "properties": { "ref": { "$ref": "#/$defs/ref" }, "edge": { "enum": ["start", "end"] }, "lag": { "$ref": "#/$defs/lag" } },
          "additionalProperties": false
        }
      ]
    },
    "point": {
      "description": "A point, with the frame its coordinates were measured in",
      "type": "object",
      "required": ["lat", "lon", "frame"],
      "properties": {
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lon": { "type": "number", "minimum": -180, "maximum": 180 },
        "frame": { "$ref": "#/$defs/ref" }
      },
      "additionalProperties": false
    },
    "text": {
      "description": "Text with its language: a map from language code to text",
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]+)*$" },
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "citation": {
      "description": "A work, and where in it: page, figure, table, record. Machine extraction adds a short quote.",
      "type": "object",
      "required": ["ref"],
      "properties": {
        "ref": { "$ref": "#/$defs/ref" },
        "loc": { "type": "string", "minLength": 1 },
        "quote": { "type": "string", "minLength": 1, "maxLength": 400 }
      },
      "additionalProperties": false
    },
    "author": {
      "description": "An account, or machine:<tool> for machine-made content",
      "type": "string",
      "pattern": "^(machine:[a-z0-9][a-z0-9-]*(@[0-9A-Za-z.+-]+)?|[A-Za-z0-9][A-Za-z0-9-]*)$"
    },
    "status": { "enum": ["proposed", "accepted", "disputed", "deprecated"] },
    "rank": { "enum": ["preferred", "normal", "deprecated"] },
    "basis": { "enum": ["evidence", "reconstruction", "projection", "procedural"] },
    "confidence": {
      "description": "A probability, or a calibrated word from the vocabulary",
      "oneOf": [{ "type": "number", "minimum": 0, "maximum": 1 }, { "type": "string", "pattern": "^[a-z][a-z-]*$" }]
    },
    "claim_common": {
      "description": "What every claim, relations included, may carry",
      "type": "object",
      "properties": {
        "subject": { "$ref": "#/$defs/ref" },
        "valid": { "$ref": "#/$defs/time" },
        "source": { "oneOf": [{ "$ref": "#/$defs/citation" }, { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/citation" } }] },
        "unsourced": { "type": "string", "minLength": 1, "description": "Why the claim has no source: a claim with none says so" },
        "confidence": { "$ref": "#/$defs/confidence" },
        "basis": { "$ref": "#/$defs/basis" },
        "alt": { "$ref": "#/$defs/record_id" },
        "author": { "$ref": "#/$defs/author" },
        "status": { "$ref": "#/$defs/status" },
        "rank": { "$ref": "#/$defs/rank" },
        "note": { "type": "string" }
      },
      "oneOf": [{ "required": ["source"], "not": { "required": ["unsourced"] } }, { "required": ["unsourced"], "not": { "required": ["source"] } }]
    }
  }
}
